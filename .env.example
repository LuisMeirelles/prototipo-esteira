# IP da máquina que roda o chat, como as pessoas vão acessar (ex.: 192.168.1.50)
HOST_IP=192.168.1.50
# Origem pública exata (https + IP). Usada na checagem de Origin (anti-CSRF e WebSocket).
PUBLIC_ORIGIN=https://192.168.1.50

# Código que quem for criar conta precisa informar (mínimo 8 caracteres).
# Gere um aleatório, ex.: openssl rand -base64 18
INVITE_CODE=
